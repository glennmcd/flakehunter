{
  "name": "flakehunter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "test": "bun --cwd packages/shared-types test && bun --cwd apps/api test && bun test scripts",
    "tunnel": "bun scripts/tunnel.ts",
    "seed:demo": "bun scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "^5.7.2"
  }
}
