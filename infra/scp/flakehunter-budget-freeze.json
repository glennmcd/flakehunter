{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FreezeEverythingExceptReadAndRecovery",
      "Effect": "Deny",
      "NotAction": [
        "cloudformation:Get*",
        "cloudformation:List*",
        "cloudformation:Describe*",
        "s3:Get*",
        "s3:List*",
        "s3:Describe*",
        "ecr:Get*",
        "ecr:List*",
        "ecr:Describe*",
        "ssm:Get*",
        "ssm:List*",
        "ssm:Describe*",
        "iam:Get*",
        "iam:List*",
        "kms:Get*",
        "kms:List*",
        "kms:Describe*",
        "lambda:Get*",
        "lambda:List*",
        "dynamodb:Get*",
        "dynamodb:List*",
        "dynamodb:Describe*",
        "logs:Get*",
        "logs:List*",
        "logs:Describe*",
        "sns:Get*",
        "sns:List*",
        "budgets:List*",
        "budgets:Describe*",
        "budgets:View*",
        "amplify:Get*",
        "amplify:List*",
        "secretsmanager:Get*",
        "secretsmanager:List*",
        "secretsmanager:Describe*",
        "route53:Get*",
        "route53:List*",
        "acm:Get*",
        "acm:List*",
        "acm:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "cloudwatch:Describe*",
        "organizations:List*",
        "organizations:Describe*",
        "account:Get*",
        "account:List*",
        "tag:Get*",
        "tag:List*",
        "tag:Describe*",
        "access-analyzer:Get*",
        "access-analyzer:List*",
        "freetier:Get*",
        "freetier:List*",
        "billing:Get*",
        "billing:List*",
        "health:Describe*",
        "cloudformation:Delete*",
        "s3:Delete*",
        "ecr:Delete*",
        "ssm:Delete*",
        "iam:Delete*",
        "lambda:Delete*",
        "dynamodb:Delete*",
        "logs:Delete*",
        "sns:Delete*",
        "amplify:Delete*",
        "secretsmanager:Delete*",
        "cloudwatch:Delete*",
        "apigateway:GET",
        "apigateway:DELETE",
        "sts:*",
        "ce:*",
        "support:*",
        "signin:*",
        "sso:*",
        "identitystore:Describe*",
        "identitystore:List*",
        "kms:Decrypt",
        "ec2:DescribeRegions",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "lambda:PutFunctionConcurrency"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/managed/AWSManaged*"
        }
      }
    }
  ]
}
