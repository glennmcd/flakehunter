{
  "app": "node --import tsx bin/flakehunter.ts",
  "build": "node --import tsx scripts/bundle-api.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "node_modules", "dist", "test", "cdk.out"]
  },
  "context": {
    "customDomain": { "domainName": "flakehunter.g26work.com", "subDomains": [""] },
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "monthlyBudgetUsd": 25,
    "reservedConcurrency": 10,
    "repository": "https://github.com/glennmcd/flakehunter",
    "githubTokenSecretName": "flakehunter/github-token"
  }
}
