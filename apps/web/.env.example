# Copy to .env.local (Next.js loads it) and fill in. These are read on the server only: never prefix them with
# NEXT_PUBLIC_, which would put them in the browser bundle.

# Where the FlakeHunter API is running.
API_BASE_URL=http://localhost:3000

# The API's global read token: the same value as API_TOKEN in apps/api/.env.
API_TOKEN=dev-local-token

# Password for the site-wide gate. Leave empty to disable the gate locally; production refuses to serve without it.
SITE_PASSWORD=
